{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend service for token distribution protocol",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test:create-stream": "ts-node src/scripts/createStream.ts",
    "init-config": "ts-node src/scripts/initConfig.ts",
    "backfill:milestone-completed-at": "ts-node src/scripts/backfillMilestoneCompletedAt.ts",
    "mcp": "ts-node src/api/mcpServer.ts",
    "cli": "ts-node src/api/cli.ts",
    "sync-idl": "node -e \"require('fs').copyFileSync('../target/idl/solana_program.json','src/idl/solana_program.json')\"",
    "build": "tsc"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.11.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
