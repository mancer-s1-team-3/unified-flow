# =====================================================================
# Cluster visibility — controls how each cluster behaves in the UI.
#   enable  : fully usable, appears in the network switcher
#   disable : appears in the switcher greyed-out (user can see it exists
#             but cannot switch to it). Config below is not required.
#   hide    : not shown in the switcher at all. Config below is not required.
# =====================================================================
NEXT_PUBLIC_DEVNET_VISIBILITY=enable
NEXT_PUBLIC_MAINNET_VISIBILITY=disable
NEXT_PUBLIC_TESTNET_VISIBILITY=hide

# Cluster used on first visit (before user picks one). Must be "enable".
NEXT_PUBLIC_DEFAULT_CLUSTER=devnet

# =====================================================================
# Devnet
# =====================================================================
NEXT_PUBLIC_DEVNET_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_DEVNET_WS_RPC=
NEXT_PUBLIC_DEVNET_PROGRAM_ID=8M5yieUh7pxwUi1YBByDF82nqoorZwaKi8dBoMVpurFa
NEXT_PUBLIC_DEVNET_API=https://backend-unified-flow.mfahrurozi.my.id

# =====================================================================
# Mainnet
# =====================================================================
NEXT_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_MAINNET_WS_RPC=
NEXT_PUBLIC_MAINNET_PROGRAM_ID=
NEXT_PUBLIC_MAINNET_API=

# =====================================================================
# Testnet
# =====================================================================
NEXT_PUBLIC_TESTNET_RPC=https://api.testnet.solana.com
NEXT_PUBLIC_TESTNET_WS_RPC=
NEXT_PUBLIC_TESTNET_PROGRAM_ID=
NEXT_PUBLIC_TESTNET_API=

# =====================================================================
# ASI:One API Configuration
# =====================================================================
ASIONE_API_KEY=your_asione_api_key_here
NEXT_PUBLIC_ASIONE_API_URL=https://api.asi1.ai/v1
NEXT_PUBLIC_ASIONE_MODEL=asi1
