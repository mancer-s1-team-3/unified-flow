# Postgres connection. Host must be the container name on the "shared" Docker network.
DATABASE_URL="postgresql://postgres:123@postgres:5432/unified-flow"

# Solana JSON-RPC HTTP endpoint.
RPC_HTTP="https://api.devnet.solana.com"

# Solana JSON-RPC WebSocket endpoint (used by the realtime indexer).
RPC_WS="wss://api.devnet.solana.com"

# Public key of the deployed on-chain program.
PROGRAM_ID="8M5yieUh7pxwUi1YBByDF82nqoorZwaKi8dBoMVpurFa"

# Host path to the Solana keypair JSON (source for the read-only volume mount).
WALLET_HOST_PATH=./secrets/id.json

# In-container path to the keypair (what the app actually reads).
WALLET_PATH=/app/secrets/id.json

# Node.js runtime mode: "production" or "development".
NODE_ENV=production

# Image tag to pull on server. Use "latest", a short SHA (e.g. "sha-abc1234"), or leave blank for "latest".
IMAGE_TAG=latest
