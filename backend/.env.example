# Cluster this backend indexes/serves: devnet | mainnet | testnet.
# Optional — if unset it is inferred from RPC_HTTP. Exposed via GET /network so
# the frontend can verify it matches the cluster selected in the UI.
CLUSTER=devnet

RPC_HTTP=https://api.devnet.solana.com
RPC_WS=wss://api.devnet.solana.com
RPC_HTTP_LIST=
RPC_WS_LIST=
RPC_HTTP_FALLBACKS=
RPC_WS_FALLBACKS=

PROGRAM_ID=8M5yieUh7pxwUi1YBByDF82nqoorZwaKi8dBoMVpurFa

DATABASE_URL=

# Allowed browser origins (comma-separated). Add your production frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://unified-flow-xi.vercel.app

# ASI:One AI chat (server-side only — never expose to the browser)
ASIONE_API_KEY=your_asione_api_key_here
ASIONE_API_URL=https://api.asi1.ai/v1
ASIONE_MODEL=asi1

IMAGE_TAG=latest

# Monitoring / observability
# Structured log verbosity: debug | info | warn | error (default: info).
LOG_LEVEL=info
# Optional error tracking. Set a DSN and wire @sentry/node in src/services/logger.ts
# (captureException) to forward exceptions to Sentry.
SENTRY_DSN=
