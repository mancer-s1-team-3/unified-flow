generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Stream {
  id        String @id
  creator   String
  recipient String
  mint      String
  vault     String

  totalAmount BigInt
  withdrawn   BigInt

  startTs BigInt
  cliffTs BigInt
  endTs   BigInt

  vestingType Int
  status      Int

  cancelable     Boolean
  milestoneCount Int
  milestones     String  @default("")
  unlockedAmount BigInt  @default(0)

  nonce        BigInt
  bump         Int
  isCsvCreated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id        String @id
  signature String @unique
  slot      BigInt

  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id])

  type String

  raw Json

  createdAt DateTime @default(now())
}

model CsvUpload {
  id        String   @id @default(uuid())
  version   Int
  filename  String
  content   String // Stores raw CSV text
  uploader  String // Wallet address of the uploader
  createdAt DateTime @default(now())
}
